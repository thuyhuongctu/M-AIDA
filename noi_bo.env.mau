# M-AIDA 8.0 - CHAY THU NOI BO: cau hinh (KHONG chua ma khoa Claude)
# Chep tep nay thanh "noi_bo.env" (cung thu muc), dien cac dong ben duoi, luu lai.
# Ma khoa Claude van chi nam trong ..\M-AIDA\backend\.env, khong chep vao day.

# Dia chi du an Supabase cua M-AIDA (Project Settings -> API Keys -> Project URL)
SUPABASE_URL=https://cdpsggkiiovciqsdavka.supabase.co

# Khoa CONG KHAI "Publishable key" (bat dau bang sb_publishable_...).
# KHONG dan khoa "Secret key" (sb_secret_...) hay service_role: bo chay se tu choi.
SUPABASE_ANON_KEY=

# E-mail duoc phep vao (cach nhau boi dau phay). Moi nguoi o day con can mot tai
# khoan do chi tao tay trong Supabase (Authentication -> Users -> Add user).
MAIDA_INVITED_EMAILS=thuyhuongctu@gmail.com

# E-mail quan tri (cap tin dung, xem chi phi, cong cu quan tri)
MAIDA_ADMIN_EMAILS=thuyhuongctu@gmail.com

# Tin dung tang moi tai khoan moi (1 tin dung = 1 luot trich xuat PDF)
MAIDA_BETA_CREDITS=10
