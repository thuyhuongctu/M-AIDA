# ── M-AIDA backend: PRODUCTION environment ────────────────────────────────
# Copy to backend/.env on the server and fill in real values.
# NEVER commit the real .env (it is git-ignored).

# LLM provider (vendor-neutral adapter). Required only for live PDF extraction;
# without a key the /api/extract endpoint returns an explicit 503 and every
# other feature (verify, lock, export, forest data) keeps working.
LLM_PROVIDER=anthropic
LLM_API_KEY=                 # <-- your provider key (SECRET: set as host secret)
LLM_MODEL=                   # <-- your approved model id

# Optional Notion sync (leave blank to disable)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# REQUIRED in production. Shared secret checked on every mutating request
# (POST/PATCH/PUT/DELETE) via the X-MAIDA-Admin-Key header - without it, any
# visitor to the public site could edit or lock studies, since nginx proxies
# /api/ to this backend with no auth of its own (see DEPLOY.md). Leave unset
# and the backend still runs, but generates a NEW random key every restart
# and only prints it to the server log - fine for a quick local check, not
# for a stable production deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAIDA_ADMIN_KEY=              # <-- SECRET: set as host secret, keep it out of git

# Server
MAIDA_PORT=8765

# CORS: only needed when the frontend is served from a DIFFERENT origin than
# the backend. In the recommended single-host setup the frontend's nginx
# proxies /api/ to the backend (same origin) so this can stay unset.
# CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Persist the study store on a mounted volume, never inside the container layer.
MAIDA_DB_PATH=/data/maida.db

# Demo behaviours must stay off in production.
MAIDA_DEMO_MODE=false
