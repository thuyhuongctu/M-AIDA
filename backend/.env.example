# Generic LLM configuration (recommended)
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=replace-with-your-approved-model-id

# Backward-compatible provider-specific variables are still accepted by the backend.
# ANTHROPIC_API_KEY=replace-with-your-provider-key
# ANTHROPIC_MODEL=replace-with-your-approved-model-id

NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...
MAIDA_PORT=8765

# Path of the SQLite file backing the study store. Records survive process
# restarts; point this at a mounted volume in container deployments.
MAIDA_DB_PATH=maida.db

# Shared secret required on every mutating request (POST/PATCH/PUT/DELETE)
# via the X-MAIDA-Admin-Key header (7.2.1). Unset here for local dev: the
# backend generates a random one at startup and prints it to the console
# instead of refusing to start. Set this for a stable key across restarts,
# and always in production (see backend/.env.production.example).
MAIDA_ADMIN_KEY=

# Demo mode. OFF by default. Presentation-only: reported in /api/health, and
# tells the admin-key guard above to stand down, because demo/run_defense.py
# already protects every mutation with its own presenter PIN
# (MAIDA_DEMO_PIN). Never enable this on a deployment that holds real
# research data - it is not a general-purpose way to disable the admin key.
MAIDA_DEMO_MODE=false
