# M-AIDA 8.x cloud configuration. Copy to deploy/.env.cloud on the server
# (never commit the copy; .gitignore excludes deploy/.env.cloud).

# --- Public entry point -----------------------------------------------------
MAIDA_DOMAIN=maida.example.org
MAIDA_ACME_EMAIL=you@example.org          # Let's Encrypt notices

# --- Identity: Supabase Auth ------------------------------------------------
MAIDA_AUTH_MODE=supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...      # Project Settings > API Keys (publishable / anon); public by design
# Only for projects still on the legacy HS256 secret (Project Settings > JWT Keys):
# SUPABASE_JWT_SECRET=
# Accounts that get the operator (admin) role on first sign-in:
MAIDA_ADMIN_EMAILS=thuyhuongctu@gmail.com
# Closed beta: who may sign in. E-mail addresses and/or whole domains with a
# leading "@", comma-separated. Empty = admins only; "*" = anyone with the link
# (each new account gets MAIDA_BETA_CREDITS paid by LLM_API_KEY).
MAIDA_INVITED_EMAILS=

# --- Data: Supabase Postgres ------------------------------------------------
# Project Settings > Database > Connection string > "Transaction pooler" (port 6543),
# with the driver prefix changed to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxxxxxxxxxx:DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Model provider ----------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=                               # server-side only; set a monthly spend limit on the provider console
LLM_MODEL=claude-sonnet-5                  # pinned; changing it is a CHANGELOG entry (validation study)
# Price table for the *estimated* cost column (USD per million tokens):
LLM_PRICE_INPUT_PER_MTOK=2
LLM_PRICE_OUTPUT_PER_MTOK=10

# --- Credits and limits -----------------------------------------------------
MAIDA_BETA_CREDITS=10
MAIDA_MAX_PDF_MB=25
MAIDA_MAX_PAGES=80
MAIDA_MAX_RUNNING_JOBS=4
MAIDA_MAX_RUNNING_JOBS_PER_USER=1
MAIDA_JOBS_PER_HOUR=10

# --- Payments: credit packs through payOS (off while MAIDA_PAYMENTS is empty) ---
# See DEPLOY_CLOUD.md, "Bán gói tín dụng qua payOS". Turn on only after the
# co-owners approve the prices and TERMS.md has the purchase terms.
MAIDA_PAYMENTS=
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Public address for the payment return pages (https, no trailing slash):
# MAIDA_PUBLIC_URL=https://maida.example.org
# Packs on sale, "id:credits:price_vnd"; unset = the DRAFT prices of the 03/10/2026 plan:
# MAIDA_CREDIT_PACKS=thu:30:149000,tongquan:100:399000,nhom:300:990000
# MAIDA_ORDER_TTL_MINUTES=30

# --- Misc -------------------------------------------------------------------
CORS_ORIGINS=["https://maida.example.org"]
MAIDA_DEMO_MODE=false
